{
  "expo": {
    "name": "ORDO",
    "slug": "ordo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.ordo.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "O ORDO usa o reconhecimento de fala para buscar produtos por voz.",
        "NSMicrophoneUsageDescription": "O ORDO usa o microfone para a busca de produtos por voz."
      }
    },
    "android": {
      "package": "br.com.ordo.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2B705",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F7F6F2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O ORDO usa a câmera para ler o código de barras dos produtos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O ORDO usa suas fotos para a imagem do produto.",
          "cameraPermission": "O ORDO usa a câmera para fotografar produtos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O ORDO usa o microfone para a busca de produtos por voz.",
          "speechRecognitionPermission": "O ORDO usa o reconhecimento de fala para buscar produtos por voz."
        }
      ]
    ],
    "scheme": "ordo",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bb84a5ad-35be-4b76-a2c0-931bbf9f4eba"
      }
    }
  }
}
